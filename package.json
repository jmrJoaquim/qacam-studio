{
  "name": "qacam-studio",
  "version": "1.1.0",
  "description": "Estúdio profissional de gravação e evidências para QA",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "keywords": [],
  "author": "Joaquim Rodrigues",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.qacam.studio",
    "productName": "QAcam Studio",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "publish": {
      "provider": "github",
      "owner": "jmrJoaquim",
      "repo": "qacam-studio"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "transcriber-worker.js",
      "icon.ico",
      "!node_modules/onnxruntime-node/bin/napi-v3/darwin/**",
      "!node_modules/onnxruntime-node/bin/napi-v3/linux/**",
      "!node_modules/onnxruntime-node/bin/napi-v3/win32/arm64/**",
      "!node_modules/onnxruntime-web/**"
    ],
    "asarUnpack": [
      "transcriber-worker.js",
      "node_modules/**"
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "@huggingface/transformers": "^3.8.1"
  }
}